# Service account — used only for Google Sheets
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# Google Drive — the parent folder ID, and OAuth2 delegation to a real
# personal Google account (service accounts have no storage quota on a
# non-Workspace account). See README for how to obtain these.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
